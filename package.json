{
  "name": "hsractionsequence",
  "private": true,
  "version": "2026.8.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "wails:frontend-build": "node scripts/sync-appicon.cjs && pnpm build",
		"test": "pnpm run test:node && pnpm run test:ui",
    "test:node": "vitest run --project node",
    "test:unit": "vitest run tests/unit",
    "test:mechanics": "vitest run tests/unit/mechanics",
    "test:simulation": "vitest run tests/unit/simulation tests/integration/simulation",
    "test:ui": "vitest run --project ui",
    "test:integration": "vitest run tests/integration",
    "test:quality": "vitest run tests/quality/properties.test.ts tests/quality/simulationContract.test.ts",
		"test:performance": "vitest run --project performance",
    "lint": "biome check src/ tests/",
		"format:check": "biome ci src/ tests/",
		"format:ci": "biome ci src/ tests/",
		"check": "pnpm run check:static && pnpm run test:node && pnpm run test:ui",
		"check:static": "pnpm exec tsc --noEmit && pnpm run check:data && pnpm run check:docs && pnpm run check:bindings && pnpm run check:architecture && pnpm run check:go && pnpm lint && pnpm format:check",
		"check:go": "node scripts/checkGo.mjs",
		"check:data": "node scripts/validateData.mjs",
		"download:favicons": "node scripts/downloadFavicons.mjs",
		"check:bindings": "node scripts/checkGeneratedBindings.mjs",
		"check:architecture": "node scripts/checkArchitecture.mjs",
    "check:docs": "node scripts/checkDocPaths.mjs",
    "docs:merge": "node scripts/merge-docs.mjs",
    "preview": "vite preview",
    "wails": "wails"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "modern-screenshot": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
